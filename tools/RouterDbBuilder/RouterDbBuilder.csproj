<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Itinero" Version="1.5.1" />
    <PackageReference Include="Itinero.IO.Osm" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- One canonical copy lives in the API project; linked here rather
         than duplicated so the build tool and RoutingService can never
         drift out of sync with each other. -->
    <None Include="..\..\src\MusterHubCommand.Api\Routing\appliance.lua.template"
          Link="appliance.lua.template" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
