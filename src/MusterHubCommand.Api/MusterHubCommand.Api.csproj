<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Itinero" Version="1.5.1" />
    <PackageReference Include="Itinero.IO.Osm" Version="1.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned above the transitive version pulled in by Microsoft.AspNetCore.OpenApi
         10.0.7 (2.0.0), which has a known high-severity advisory (GHSA-v5pm-xwqc-g5wc).
         Staying on the 2.x line (not 3.x): Microsoft.AspNetCore.OpenApi 10.0.7's source
         generator is built against 2.x's API shape (e.g. a settable IOpenApiMediaType.Example),
         which 3.x made read-only, breaking the build. Same pin as Rota/Skills. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The appliance vehicle-profile Lua template, read as text at
         startup and templated per VehicleProfile, not compiled in. -->
    <None Include="Routing\appliance.lua.template" CopyToOutputDirectory="PreserveNewest" />
    <!-- Dev-only routerdb fixture, a small Tavistock-area extract.
         Prod overrides Routing:RouterDbPath to a real regional one
         uploaded separately, see provision-prod.sh. -->
    <None Include="App_Data\dev-tavistock.routerdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
