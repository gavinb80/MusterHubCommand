{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=musterhubcommand;Username=CHANGE_ME;Password=CHANGE_ME"
  },
  "Core": {
    "JwksUri": "https://musterhub-api.azurewebsites.net/.well-known/jwks.json",
    "Issuer": "MusterHub",
    "Audience": "MusterHubApp"
  },
  "Routing": {
    "RouterDbPath": "App_Data/dev-tavistock.routerdb"
  }
}
