<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MusterHubCommandTablet.Views.NavigatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MusterHubCommandTablet.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:NavigateViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="MapIconButton" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="MapZoomButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The upcoming maneuver, glanceable at a distance, using the
             same deep navy as the app's own icon, not a one-off colour. -->
        <Border
            Grid.Row="0"
            BackgroundColor="{StaticResource Secondary}"
            StrokeThickness="0"
            Padding="20,16"
            IsVisible="{Binding CurrentInstructionText, Converter={StaticResource StringNotEmptyToBoolConverter}}">
            <Label
                Text="{Binding CurrentInstructionText}"
                TextColor="{StaticResource White}"
                FontSize="30"
                FontAttributes="Bold" />
        </Border>

        <WebView
            x:Name="MapWebView"
            Grid.Row="1"
            Source="{Binding MapSource}"
            Navigated="OnMapNavigated" />

        <Button
            Grid.Row="1"
            Text="{Binding OrientationToggleLabel}"
            Command="{Binding ToggleOrientationCommand}"
            Style="{StaticResource SecondaryButton}"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="12" />

        <!-- Replaces Leaflet's own +/- control, which is invisible on this
             screen. See index.html's zoomControl:false comment. -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Spacing="8">
            <Button Text="+" Style="{StaticResource MapZoomButton}" Command="{Binding ZoomInCommand}" />
            <Button Text="&#8722;" Style="{StaticResource MapZoomButton}" Command="{Binding ZoomOutCommand}" />
        </VerticalStackLayout>

        <!-- Manual camera controls: centre on this appliance's own position,
             centre on the incident, or fit both in view. See index.html's
             followAppliance comment: the first button is also how the
             crew resumes auto-follow after using either of the other two. -->
        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="End" VerticalOptions="End" Margin="12" Spacing="8">
            <ImageButton
                Source="center_location.svg"
                Style="{StaticResource MapIconButton}"
                Command="{Binding CenterOnLocationCommand}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </ImageButton.Behaviors>
            </ImageButton>
            <ImageButton
                Source="center_incident.svg"
                Style="{StaticResource MapIconButton}"
                Command="{Binding CenterOnIncidentCommand}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </ImageButton.Behaviors>
            </ImageButton>
            <ImageButton
                Source="fit_both.svg"
                Style="{StaticResource MapIconButton}"
                Command="{Binding ShowBothCommand}">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </ImageButton.Behaviors>
            </ImageButton>
        </HorizontalStackLayout>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label
                        Text="{Binding RouteSummary}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Text="End navigation"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding EndNavigationCommand}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Solid, not translucent, since a WebView can ignore z-order and
             opacity on some platforms. Covers exactly the delay (incident
             fetch, GPS fix, first route computation) that previously had
             no visual indication at all. -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            StrokeThickness="0"
            IsVisible="{Binding IsLoadingRoute}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoadingRoute}" Color="{StaticResource Secondary}" HeightRequest="48" WidthRequest="48" />
                <Label Text="Getting your position and route..." Style="{StaticResource CardSubtitleLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
