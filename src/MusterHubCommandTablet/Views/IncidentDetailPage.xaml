<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MusterHubCommandTablet.Views.IncidentDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MusterHubCommandTablet.ViewModels"
    xmlns:models="clr-namespace:MusterHubCommandTablet.Models"
    x:DataType="vm:IncidentDetailViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="&#8592; Back" Style="{StaticResource SecondaryButton}" Command="{Binding GoBackCommand}" />
                <Border Grid.Column="2" Style="{StaticResource StatusPillBorder}" BackgroundColor="{Binding Incident.Status, Converter={StaticResource StatusToColorConverter}}" VerticalOptions="Center">
                    <Label Text="{Binding Incident.Status}" Style="{StaticResource StatusPillLabel}" />
                </Border>
            </Grid>

            <Label Text="{Binding Incident.IncidentType}" Style="{StaticResource PageTitleLabel}" />
            <Label Text="{Binding Incident.Address}" Style="{StaticResource CardSubtitleLabel}" />
            <Label Text="{Binding Incident.Description}" IsVisible="{Binding Incident.Description, Converter={StaticResource StringNotEmptyToBoolConverter}}" />

            <WebView
                x:Name="MapWebView"
                Source="{Binding MapSource}"
                IsVisible="{Binding ShowMap}"
                HeightRequest="280"
                Navigated="OnMapNavigated" />

            <Label
                Text="No location set for this incident yet."
                Style="{StaticResource CardSubtitleLabel}"
                IsVisible="{Binding HasLocation, Converter={StaticResource InvertedBoolConverter}}" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasLocation}">
                <Label
                    Grid.Column="0"
                    Text="{Binding RouteSummary}"
                    Style="{StaticResource CardSubtitleLabel}"
                    VerticalOptions="Center"
                    IsVisible="{Binding RouteSummary, Converter={StaticResource StringNotEmptyToBoolConverter}}" />
                <Button
                    Grid.Column="1"
                    Text="{Binding MapToggleLabel}"
                    Command="{Binding ToggleMapCommand}"
                    Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasLocation}">
                <Button
                    Grid.Column="0"
                    Text="Start navigation"
                    Command="{Binding StartNavigationCommand}"
                    IsEnabled="{Binding IsStartingNavigation, Converter={StaticResource InvertedBoolConverter}}"
                    HorizontalOptions="Fill" />
                <ActivityIndicator
                    Grid.Column="1"
                    IsRunning="{Binding IsStartingNavigation}"
                    IsVisible="{Binding IsStartingNavigation}"
                    Margin="12,0,0,0" />
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Attendance" Style="{StaticResource CardTitleLabel}" />
                    <Label Text="No appliances attending yet." Style="{StaticResource CardSubtitleLabel}" IsVisible="{Binding Incident.Appliances, Converter={StaticResource CollectionEmptyConverter}}" />
                    <CollectionView ItemsSource="{Binding Incident.Appliances}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:IncidentApplianceDto">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                    <Label Grid.Column="0" Text="{Binding Callsign}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource StatusPillBorder}" BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                        <Label Text="{Binding Status}" Style="{StaticResource StatusPillLabel}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Timeline" Style="{StaticResource CardTitleLabel}" />

                    <CollectionView ItemsSource="{Binding Timeline}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineEntry">
                                <!-- Rail column: a full-height line behind a
                                     small dot, per row. With tight row
                                     spacing this reads as one continuous
                                     line down the card, the same effect the
                                     web console gets from a single
                                     absolutely-positioned line, achieved
                                     here per-row since MAUI has no
                                     equivalent to that. -->
                                <Grid ColumnDefinitions="20,*" Padding="0,0,0,12">
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="2"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Fill"
                                        Margin="0,4,0,0" />
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        StrokeShape="RoundRectangle 5"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding Kind, Converter={StaticResource TimelineKindToColorConverter}}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Start"
                                        Margin="0,4,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding Caption}"
                                                Style="{StaticResource CaptionLabel}"
                                                FontAttributes="Bold"
                                                TextColor="{Binding Kind, Converter={StaticResource TimelineKindToColorConverter}}" />
                                            <Label Grid.Column="1" Text="{Binding Timestamp, StringFormat='{0:g}'}" Style="{StaticResource CaptionLabel}" />
                                        </Grid>
                                        <Label Text="{Binding Text}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Editor Placeholder="Add a note..." Text="{Binding NoteText}" AutoSize="TextChanges" MaxLength="1000" />
                    <Button Text="Post note" Command="{Binding AddNoteCommand}" IsEnabled="{Binding IsPostingNote, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource StatusHazard}"
                IsVisible="{Binding HasError}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
