<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MusterHubCommandTablet</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- A dedicated, kiosk-style app for the appliance tablet - separate
		     App Store/Play Store listing, own bundle ID and release cadence
		     from the main MusterHub app, decoupled deliberately (see the
		     architecture plan's "tablet's auth model" section). -->
		<ApplicationTitle>MusterHub Command</ApplicationTitle>
		<ApplicationId>app.musterhub.command</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Dedicated release key, separate from MusterHubApp's, same reasoning
		     as the separate bundle ID: a distinct product shouldn't share a
		     single point of failure with the main app's signing key.
		     Passwords come in via -p: at publish time, never committed,
		     same pattern as MusterHubApp.csproj. -->
		<AndroidKeyStore Condition="'$(Configuration)' == 'Release'">true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release'">musterhubcommand.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(Configuration)' == 'Release'">musterhubcommand</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass Condition="'$(Configuration)' == 'Release'">$(MusterHubCommandKeyPass)</AndroidSigningKeyPass>
		<AndroidSigningStorePass Condition="'$(Configuration)' == 'Release'">$(MusterHubCommandStorePass)</AndroidSigningStorePass>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1F3A" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1F3A" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Sentry.Maui" Version="5.*" />
	</ItemGroup>

	<!-- Signing credentials loaded from local file (not committed) - same
	     convention as MusterHubApp's signing.props. -->
	<Import Project="signing.props" Condition="Exists('signing.props')" />

</Project>
